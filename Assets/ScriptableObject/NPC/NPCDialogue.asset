  m_Script: {fileID: 11500000, guid: 46a13c4f1df95294286ccd82a5496ff9, type: 3}
  m_Name: NPCDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Little Square
  npcPortrait: {fileID: 9133988509631934656, guid: 3fb775950fe57c5498a9cef5c71902c5, type: 3}
  dialogueLines:
  - 'Hey, traveler! I need your help.

    There is a strange puzzle blocking our
    way.

    Solve it, and we can pass safely.

    Listen carefully...'
  - 'Three brothers stand before you: White, Black, and Gray.

    Two were here
    from the very first day.

    The third was born when the other two became one.

    Only
    the true two may awaken the buttons.'
